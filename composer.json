{
    "name": "zeiras/zr-core",
    "description": "Zeiras: la cornice comune dei frontend zr-* (AppShell, menu Prodotti, selettore di workspace, ricerca, notifiche, menu del profilo, registro dei prodotti) e il design system nella build.",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ma-cpmakers/zr-auth"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "zeiras/zr-auth": "^0.6.6 || ^0.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Zeiras\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeiras\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zeiras\\Core\\ZrCoreServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.26"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
